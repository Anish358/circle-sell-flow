# Postgres connection string.
# Local (matches docker-compose.yml):
DATABASE_URL="postgresql://circle:circle@localhost:54322/circle"
# Supabase: Project Settings → Database → Connection string → URI.
# Use the *direct* connection (port 5432) for migrations and the pooled one
# (port 6543) for the running app if you separate them.
