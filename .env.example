# Copy to .env and fill in.

# ─── Local development (matches docker-compose.yml) ───────────────────────────
# One connection string is enough locally: there is no connection pooler.
DATABASE_URL="postgresql://circle:circle@localhost:54322/circle"


# ─── Deployment (Supabase + Vercel) ──────────────────────────────────────────
# Two connection strings, because they need different pooling modes.
#
# DATABASE_URL — the running app. Supabase → Connect → Transaction pooler
#   (port 6543). Serverless functions are short-lived and stateless, which is
#   exactly what a transaction pooler is for. It does not support prepared
#   statements, which is why the client sets `prepare: false`.
#
# MIGRATION_DATABASE_URL — migrations only. Supabase → Connect → Session pooler
#   (port 5432). Migrations need session state that a transaction pooler does
#   not keep. Omit this locally and migrations use DATABASE_URL.
#
# Avoid the "Direct connection" string in both: it is IPv6-only unless you buy
# Supabase's IPv4 add-on, and Vercel cannot reach it.
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# MIGRATION_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
